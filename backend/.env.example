# O mock também usa 3001: execute um servidor de cada vez.
PORT=3001
HOST=127.0.0.1
# Origens separadas por vírgula; caminhos como /AUTOCUIDA-PSW/ não entram aqui.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
# Obrigatório para iniciar a API. Exemplo local; não instala o banco.
MONGO_URL=mongodb://127.0.0.1:27017/autocuida
MONGO_TIMEOUT_MS=5000
